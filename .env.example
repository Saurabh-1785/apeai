# ===========================================
# ApeAI — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ===========================================

# ------------------------------------------
# Supabase (REQUIRED)
# Get these from: https://supabase.com → Project Settings → API
# ------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co

# BACKEND ONLY. The service_role key (bypasses Row Level Security).
# Never expose this to the browser / never prefix it with NEXT_PUBLIC_.
SUPABASE_KEY=your-service-role-key

# FRONTEND. The public anon key — safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key


# ------------------------------------------
# Google AI (REQUIRED — embeddings use gemini-embedding-001, generation gemini-2.5-flash-lite)
# Get your key from: https://aistudio.google.com/app/apikey
# ------------------------------------------
GOOGLE_API_KEY=your-google-api-key

# ------------------------------------------
# Server Configuration
# ------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Frontend → backend wiring (used by frontend/next.config.js)
# Browser calls go to NEXT_PUBLIC_API_URL; the default "/api" is proxied
# by Next.js to BACKEND_URL. In production set NEXT_PUBLIC_API_URL to the
# public backend URL (or set BACKEND_URL on the frontend host).
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://127.0.0.1:8000
